<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationRemove">
        <success>Always</success>
        <xpath>/Defs/ThingDef[defName="RB_DoubleDoor"]/researchPrerequisites</xpath>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="RB_DoubleDoor"]</xpath>
        <value>
          <researchPrerequisites Inherit="False">
            <li>Ferny_Door</li>
          </researchPrerequisites>
        </value>
      </li>
    </operations>
  </Operation>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationRemove">
        <success>Always</success>
        <xpath>/Defs/ThingDef[defName="RB_RusticWall"]/researchPrerequisites</xpath>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="RB_RusticWall"]</xpath>
        <value>
          <researchPrerequisites Inherit="False">
            <li>Ferny_Wall</li>
          </researchPrerequisites>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
