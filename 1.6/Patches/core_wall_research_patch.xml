<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationRemove">
        <success>Always</success>
        <xpath>/Defs/ThingDef[defName="Wall"]/researchPrerequisites</xpath>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Wall"]</xpath>
        <value>
          <researchPrerequisites>
            <li>Ferny_Wall</li>
          </researchPrerequisites>
        </value>
      </li>
      <li Class="PatchOperationAdd" MayRequire="Ludeon.RimWorld.Anomaly">
        <xpath>/Defs/ThingDef[defName="GrayWall"]</xpath>
        <value>
          <researchPrerequisites Inherit="False" />
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
